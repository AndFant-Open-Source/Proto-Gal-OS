# Copiare in .env e compilare. Il file .env non va mai pubblicato (è in .gitignore).

# Supabase — Project Settings → API (usare SOLO la chiave "anon public", mai la service_role)
VITE_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Ente
VITE_NOME_ENTE=Nome del GAL
VITE_ANNO_CORRENTE=2026

# Uffici dell'ente, separati da punto e virgola (facoltativo: se vuoto si usa un elenco predefinito)
VITE_UFFICI=Direzione;Amministrazione;Segreteria;Programmazione e Sviluppo

# Indirizzo pubblico del codice sorgente, mostrato a piè di pagina
# (Linee guida AgID su acquisizione e riuso del software, Allegato A §A.2)
VITE_URL_CODICE_SORGENTE=https://github.com/AndFant-Open-Source/Proto-Gal-OS
